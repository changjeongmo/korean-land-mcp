# Korean Land MCP Configuration
# === 실제 데이터 연동을 위한 API 키 (선택사항) ===
# vworld.kr (무료 키 발급 추천) → https://vworld.kr
VWORLD_API_KEY=your_vworld_key_here
# V-World 인증키에 등록한 서비스 URL(도메인)
VWORLD_DOMAIN=localhost
# 원격 배포 시 커넥터 접근 토큰 (Authorization: Bearer <값>)
MCP_TOKEN=

# data.go.kr 일반 인증키(Decoding 권장) — 실거래가·버스정류장 도구
# 활용신청 필요: 국토교통부 실거래가 8종(아파트/오피스텔/연립다세대/단독다가구 매매·전월세, 상업업무용, 토지, 공장창고, 분양권),
#               국토교통부_(TAGO)_버스정류소정보, 서울특별시_정류소정보조회 서비스
#               + 공공데이터 전체 게이트웨이: '공공데이터활용지원센터_목록조회서비스'(15077093, 자동승인) 1건 필수,
#                 그 밖의 API는 쓰려는 것만 각각 활용신청(같은 키 하나로 호출)
DATA_GO_KR_KEY=your_data_gov_key_here

# (선택) call_public_api 허용 도메인 추가. 기본: *.go.kr, *.or.kr, *.re.kr, odcloud.kr
PUBLIC_API_EXTRA_HOSTS=

# Kakao Developers REST API 키 — 지하철역·주변시설·자동차 소요시간 도구
KAKAO_REST_KEY=your_kakao_rest_key_here

# MCP Server Port (for HTTP mode)
PORT=3000
MCP_TRANSPORT=stdio

# Optional: Logging level
LOG_LEVEL=info
